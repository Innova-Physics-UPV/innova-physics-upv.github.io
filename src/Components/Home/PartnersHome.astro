---
import { partners } from '../../data/partners';
---

<section class="contenedor overflow-wrapper" aria-labelledby="partners-title">
  <div class="heading-align left">
    <div class="title-wrapper arrow-left">
      <h2 id="partners-title">Partners</h2>
    </div>
  </div>

  <ul class="partner-grid">
    {partners.map(({ name, logo, url }) => (
      <li class="partner">
        <a href={url} target="_blank" rel="noopener noreferrer">
          <img src={logo} alt={name} class="partner-logo" />
        </a>
      </li>
    ))}
  </ul>

  <div class="btn-container more-partners">
    <a href="/partners" class="btn">Become a partner</a>
  </div>
</section>

<style>
  /* The background is already red here, so the brand red would not show. */
  .title-wrapper { --c-arrow: var(--c-arrow-alt); }

  .heading-align { margin-bottom: 0; }

  .partner-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: center;
    gap: 3rem;
    margin-top: 5rem;
  }

  .partner {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 6rem;
  }

  /* Full width, so the logo's max-width: 100% has something to resolve against. */
  .partner a {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .partner-logo {
    width: auto;
    max-width: 100%;
    max-height: 5rem;
    aspect-ratio: auto;
    object-fit: contain;
    opacity: 0.9;
    transition: opacity 0.2s ease;
  }

  .partner-logo:hover {
    opacity: 1;
  }

  .more-partners { margin-top: 4rem; }

  @media (max-width: 850px) {
    .partner-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }

  @media (max-width: 480px) {
    .partner-grid {
      gap: 2rem;
      margin-top: 2rem;
    }

    .partner-logo {
      max-height: 3.5rem;
    }
  }
</style>
