---
// DemocratizingAccelerator.astro
---
<section class="section-full-bleed">
  <div class="contenedor no-padding-bottom">
    <h2>Democratizing Accelerator<br />Physics Education</h2>
  </div>

  <div class="bleed-row">
    <div class="content-left">
      <p>Innova Physics UPV develops learning tools, competitions and open-access technologies to bridge the global skills gap in accelerator science.</p>
    </div>
    <img src="/equipo.webp" alt="Innova Physics Team" class="img-curve-left image-right" />
  </div>

  <div class="bleed-row">
    <img src="/dispositivo.webp" alt="Accelerator Device" class="img-curve-right image-left" />
    <div class="content-right btn-container">
      <div class="flex-col-center">
        <p class="text-accent text-small">Dou you want to join?</p>
        <a href="https://app.formbricks.com/s/cmtu7yz8fjked01z5rk1eelti?utm_source=ig&utm_medium=social&utm_content=link_in_bio&fbclid=PAb21jcAUgsQ5wZG9mAmV4dG4DYWVtAjExAHNydGMGYXBwX2lkDzU2NzA2NzM0MzM1MjQyNwABp4XaZtMifvL9KRqGI574zYlVdHHKteqCzw93RL7JtR3nGDFQCKIj4-CuUJ-4_aem_Kird4vURgc_0wBUzdjedCw" target="_blank" class="btn">Join the mission</a>
      </div>
      <div class="flex-col-center">
        <p class="text-accent text-small">See what we do</p>
        <a class="btn">Explore the projects</a>
      </div>
    </div>
  </div>
</section>

<style>
  .section-full-bleed {
    display: flex;
    flex-direction: column;
    gap: 6rem;
    padding-block: var(--space-section);
  }

  .no-padding-bottom {
    padding-bottom: 0;
  }
.bleed-row {
    display: grid;
    grid-template-columns: 
      minmax(var(--space-section-inline), 1fr) 
      minmax(0, calc(var(--container) / 2 - 1.5rem)) 
      minmax(0, calc(var(--container) / 2 - 1.5rem)) 
      minmax(var(--space-section-inline), 1fr);
    gap: 3rem;
    align-items: center;
  }

  .content-left { grid-column: 2 / 3; }
  
  .image-right { 
    grid-column: 3 / 5; 
    width: 100%; 
    height: 100%; 
    object-fit: cover; 
  }
  .image-left { 
    grid-column: 1 / 3; 
    width: 100%; 
    height: 100%; 
    object-fit: cover; 
  }
  .content-right { grid-column: 3 / 4; }

  /* ─── Mobile ─── */
  @media (max-width: 768px) {
    .bleed-row {
      display: flex;
      flex-direction: column;
      gap: 3rem;
    }

    .content-left, .content-right {
      padding-inline: var(--space-section-inline);
    }

    .image-left, .image-right {
      width: 100%;
      /* En móvil no queremos el borde curvo asimétrico si ocupa el 100% */
      border-radius: 35px; 
    }
  }
</style>
