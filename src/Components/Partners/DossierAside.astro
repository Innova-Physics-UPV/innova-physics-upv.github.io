---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { CONTACT_EMAIL, DOSSIER_URL } from '../../consts';
import { benefits, tiers } from '../../data/sponsorship';

// Checked at build time: the button only appears once public/dossier.pdf exists.
const hasDossier = existsSync(join(process.cwd(), 'public', DOSSIER_URL));

// One row per benefit, one cell per tier: included from its tier upwards.
const rows = benefits.map(({ text, from }) => {
  const first = tiers.findIndex((tier) => tier.name === from);
  return { text, included: tiers.map((_, i) => i >= first) };
});
---

<aside class="dossier" aria-labelledby="dossier-title">
  <h2 id="dossier-title">Join as a partner</h2>
  <p class="text-accent lead">Software, equipment, services or funding. Every contribution is credited where it is used: in our public documentation, on our posters, on the machine.</p>

  <table class="benefits text-accent">
    <thead>
      <tr>
        <td></td>
        {tiers.map(({ name, color }) => (
          <th scope="col" style={`--tier: ${color}`}><span>{name}</span></th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map(({ text, included }) => (
        <tr>
          <th scope="row">{text}</th>
          {included.map((on, i) => (
            <td style={`--tier: ${tiers[i].color}`}>
              <span class:list={['dot', { on }]} aria-hidden="true"></span>
              <span class="sr-only">{on ? 'Included' : 'Not included'}</span>
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>

  <p class="text-accent note">Higgs is also by invitation. Licences, loans and donated equipment count too.</p>
  <p class="text-accent lead">Twenty minutes is enough to show you the machine and find where you fit.</p>

  <div class="actions">
    {hasDossier && <a class="btn" href={DOSSIER_URL} download="Innova-Physics-Partnership-Dossier-2026-27.pdf">Download the dossier</a>}
    <a class="btn" href={`mailto:${CONTACT_EMAIL}?subject=Partnership`}>Contact us</a>
  </div>
</aside>

<style>
  .dossier {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 35px;
    /* Nearly opaque, so the background curves don't run behind the text. */
    background: rgba(10, 10, 25, 0.88);
  }

  .dossier h2 { font-size: var(--fs-h3); }

  .lead,
  .note {
    max-width: 40rem;
    font-size: var(--fs-small);
    font-weight: 400;
    line-height: 1.4;
  }

  .note {
    font-size: 0.875rem;
    opacity: 0.8;
  }

  /* Fixed layout: column widths come from the header row. Browsers size
     vertical text as if it were horizontal, which squeezed the benefit column. */
  .benefits {
    width: 100%;
    max-width: 40rem;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: 0.8rem;
    font-weight: 400;
    line-height: 1.3;
  }

  /* Tier names run vertically so four columns fit in the side column. */
  /* Tier names in white with a bar in the tier colour underneath. */
  .benefits thead th {
    width: 1.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 3px solid var(--tier);
    vertical-align: bottom;
    color: var(--c-text);
    font-family: var(--ff-main);
    font-weight: 600;
  }

  .benefits thead th span {
    display: inline-block;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .benefits tbody tr { border-top: 1px solid rgba(255, 255, 255, 0.12); }

  .benefits tbody th {
    padding: 0.45rem 0.5rem 0.45rem 0;
    font-weight: 400;
    text-align: left;
  }

  .benefits td { text-align: center; }

  .dot {
    display: inline-block;
    width: 0.7rem;
    height: 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    vertical-align: middle;
  }

  .dot.on {
    border-color: var(--tier);
    background: var(--tier);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .actions .btn { flex: 1 1 12rem; max-width: 22rem; }

  /* Below 1200px partners.astro moves this box under the partners, full
     width: there is room for the tier names to run horizontally. */
  @media (min-width: 601px) and (max-width: 1200px) {
    .benefits thead th span {
      writing-mode: horizontal-tb;
      transform: none;
    }

    .benefits thead th { width: 5.5rem; }
  }
</style>
