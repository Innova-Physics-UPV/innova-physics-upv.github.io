---
import { partners } from '../../data/partners';
import { tiers } from '../../data/sponsorship';

// Tiers from Higgs down; the top tier gets the big cards. Empty tiers are hidden.
const levels = [...tiers]
  .reverse()
  .map(({ name, color }, i) => ({ name, color, top: i === 0, members: partners.filter((p) => p.tier === name) }))
  .filter((level) => level.members.length > 0);
---

<section class="partner-wall" aria-labelledby="partner-wall-title">
  <h2 id="partner-wall-title">Our partners</h2>
  <p class="text-accent intro">The organisations that make Innova Physics UPV possible.</p>

  {levels.map(({ name, color, top, members }) => (
    <div class="level">
      <h3 style={`--tier: ${color}`}>{name}</h3>
      <ul class:list={['partner-grid', { top }]}>
        {members.map(({ name, logo, url }) => (
          <li>
            <a class="partner-card" href={url} target="_blank" rel="noopener noreferrer">
              <img src={logo} alt={name} class="partner-logo" loading="lazy" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</section>

<style>
  .partner-wall h2 { font-size: var(--fs-h3); }

  .intro {
    margin: 0.5rem 0 2rem;
    font-size: var(--fs-small);
    font-weight: 400;
  }

  .level + .level { margin-top: 3rem; }

  /* White text with a bar in the tier colour: the colours alone are too
     faint to read over the background. */
  .level h3 {
    display: inline-block;
    margin-bottom: 1rem;
    padding-bottom: 0.25rem;
    border-bottom: 3px solid var(--tier);
    font-size: 1.125rem;
  }

  /* The top tier gets big cards; the tiers below get smaller ones. */
  .partner-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .partner-grid.top {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .partner-card {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 9rem;
    height: 100%;
    padding: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 35px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--c-text);
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .top .partner-card {
    min-height: 16rem;
    padding: 2.5rem 2rem;
  }

  .partner-card:hover {
    border-color: rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.09);
  }

  /* The global img rule crops to 16:9; logos keep their own shape. */
  .partner-logo {
    width: 100%;
    max-width: 12rem;
    max-height: 4rem;
    aspect-ratio: auto;
    object-fit: contain;
  }

  .top .partner-logo {
    max-width: 22rem;
    max-height: 7rem;
  }

  @media (max-width: 850px) {
    .partner-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 480px) {
    .partner-grid,
    .partner-grid.top { grid-template-columns: 1fr; }
    .top .partner-card { min-height: 11rem; padding: 2rem 1.5rem; }
    .top .partner-logo { max-height: 5rem; }
  }
</style>
