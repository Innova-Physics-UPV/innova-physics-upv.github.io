<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">
    <meta name="generator" content={Astro.generator}>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="stylesheet" href="/favicon.ico">
    <title>Nuestro Enfoque - Innova Physics</title>
</head>
<body>
    <!-- Navigation Header -->
    <nav class="main-nav">
        <div class="logo">
            <h2>Innova Physics</h2>
        </div>
        <ul class="nav-links">
            <li><a href="/">Inicio</a></li>
            <li><a href="/about-us">Sobre Nosotros</a></li>
            <li><a href="/our-approach" class="active">Nuestro Enfoque</a></li>
            <li><a href="/get-started">Comenzar</a></li>
            <li><a href="/contact">Contacto</a></li>
        </ul>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-content">
            <h1>Our Aproach</h1>
            <p class="subtitle">Cómo lo hacemos</p>
            <div class="approach-buttons">
                <a href="#eliac" class="approach-btn">ELIAC</a>
                <a href="#linac" class="approach-btn">LINAC</a>
                <a href="#ruta" class="approach-btn">RUTA</a>
            </div>
            <div class="scroll-indicator">
                <span>↓</span>
            </div>
        </div>
    </section>

    <!-- ELIAC Section -->
    <section id="eliac" class="eliac-section">
        <div class="left-content">
            <h2>ELIAC</h2>
            <p>Promueve el diseño, simulación y capacitación colaborativa en ciencia de aceleradores.</p>
            <button class="learn-more-btn">Conocer más →</button>
        </div>
        <div class="right-content">
            <div class="info-card">
                <h3>Diseño Interactivo</h3>
                <p>Plataforma colaborativa para simulación y capacitación en física de aceleradores.</p>
            </div>
        </div>
    </section>

    <!-- LINAC Section -->
    <section id="linac" class="linac-section">
        <div class="left-content">
            <h2>LINAC</h2>
            <p>Un acelerador de entrenamiento: económico, pequeño, seguro y modular.</p>
            <button class="learn-more-btn">Conocer más →</button>
        </div>
        <div class="right-content">
            <div class="info-card">
                <h3>Cronología de Desarrollo</h3>
                <p>Construyendo el futuro de la tecnología accesible de capacitación en aceleradores.</p>
            </div>
        </div>
    </section>

    <!-- Timeline Section -->
    <section id="ruta" class="timeline-section">
        <div class="timeline-header">
            <h2>Nuestra Hoja de Ruta</h2>
            <p>El camino hacia la revolución en la capacitación en aceleradores</p>
        </div>

        <div class="timeline-container">
            <div class="timeline-line"></div>

            <div class="timeline-item left">
                <div class="timeline-content">
                    <div class="timeline-date">T1 2025</div>
                    <h3>Lanzamiento Plataforma ELIAC</h3>
                    <p>Lanzamiento de la plataforma colaborativa de diseño y simulación para ciencia de aceleradores.</p>
                    <ul class="milestone-list">
                        <li>Pruebas beta con universidades asociadas</li>
                        <li>Optimización de interfaz de usuario</li>
                        <li>Módulos de simulación básicos</li>
                    </ul>
                </div>
                <div class="timeline-marker"></div>
            </div>

            <div class="timeline-item right">
                <div class="timeline-content">
                    <div class="timeline-date">T3 2025</div>
                    <h3>Desarrollo Prototipo LINAC</h3>
                    <p>Construcción del primer prototipo de acelerador modular de entrenamiento.</p>
                    <ul class="milestone-list">
                        <li>Finalización del diseño de componentes</li>
                        <li>Establecimiento de protocolos de seguridad</li>
                        <li>Primeras pruebas de ensamblaje</li>
                    </ul>
                </div>
                <div class="timeline-marker"></div>
            </div>

            <div class="timeline-item left">
                <div class="timeline-content">
                    <div class="timeline-date">T1 2026</div>
                    <h3>Alianzas Educativas</h3>
                    <p>Colaboración con universidades líderes para integrar nuestra tecnología en los planes de estudio.</p>
                    <ul class="milestone-list">
                        <li>Programas piloto en 5 universidades</li>
                        <li>Desarrollo de materiales de capacitación</li>
                        <li>Integración de feedback de estudiantes</li>
                    </ul>
                </div>
                <div class="timeline-marker"></div>
            </div>

            <div class="timeline-item right">
                <div class="timeline-content">
                    <div class="timeline-date">T3 2026</div>
                    <h3>LINAC Listo para Producción</h3>
                    <p>Producción en masa de aceleradores de entrenamiento modulares y asequibles para instituciones de todo el mundo.</p>
                    <ul class="milestone-list">
                        <li>Alianzas de fabricación</li>
                        <li>Protocolos de aseguramiento de calidad</li>
                        <li>Red de distribución global</li>
                    </ul>
                </div>
                <div class="timeline-marker"></div>
            </div>

            <div class="timeline-item left">
                <div class="timeline-content">
                    <div class="timeline-date">2027+</div>
                    <h3>Impacto Global</h3>
                    <p>Democratizando la educación en física de aceleradores a través de los continentes.</p>
                    <ul class="milestone-list">
                        <li>Más de 100 instituciones equipadas</li>
                        <li>Red de colaboración en investigación</li>
                        <li>Innovaciones de próxima generación</li>
                    </ul>
                </div>
                <div class="timeline-marker"></div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="main-footer">
        <div class="footer-content">
            <div class="footer-logo">
                <h3>Innova Physics</h3>
            </div>
            <div class="footer-links">
                <ul>
                    <li><a href="/">Inicio</a></li>
                    <li><a href="/about-us">Sobre Nosotros</a></li>
                    <li><a href="/our-approach">Nuestro Enfoque</a></li>
                    <li><a href="/get-started">Comenzar</a></li>
                    <li><a href="/contact">Contacto</a></li>
                </ul>
            </div>
            <div class="footer-contact">
                <p><strong>📧</strong> innovaphysics.pr@gmail.com</p>
                <p><strong>📍</strong> Innova Physics UVIC</p>
                <p><strong>📱</strong> +34605658004</p>
                <p><strong>📧</strong> info@innovaphysics.com</p>
            </div>
            <div class="footer-partners">
                <p>Universidades Asociadas</p>
            </div>
        </div>
    </footer>
</body>
</html>

<style>
/* Reset and Base Styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Arial', sans-serif;
    color: #fff;
    background: #000;
    overflow-x: hidden;
}

/* Navigation */
.main-nav {
    position: fixed;
    top: 0;
    width: 100%;
    background: rgba(0, 0, 0, 0.9);
    padding: 1rem 2rem;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    z-index: 1000;
    backdrop-filter: blur(10px);
}

.logo h2 {
    color: #fff;
    font-size: 1.2rem;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 2rem;
    justify-content: flex-end;
}

.nav-links a {
    color: #fff;
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.3s;
}

.nav-links a:hover,
.nav-links a.active {
    color: #ff6b9d;
}

/* Hero Section */
.hero-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
    position: relative;
    overflow: hidden;
}

.hero-section::before {
    content: '';
    position: absolute;
    width: 150%;
    height: 150%;
    background:
        linear-gradient(45deg, transparent 45%, rgba(255, 107, 157, 0.1) 50%, transparent 55%),
        linear-gradient(-45deg, transparent 45%, rgba(138, 43, 226, 0.1) 50%, transparent 55%);
    animation: wave 15s linear infinite;
}

@keyframes wave {
    0% { transform: translate(-50%, -50%) rotate(0deg); }
    100% { transform: translate(-50%, -50%) rotate(360deg); }
}

.hero-content {
    text-align: center;
    z-index: 1;
    position: relative;
}

.hero-content h1 {
    font-size: 4rem;
    font-weight: bold;
    margin-bottom: 1rem;
    text-shadow: 0 0 30px rgba(255, 107, 157, 0.5);
}

.subtitle {
    font-size: 1.5rem;
    margin-bottom: 3rem;
    opacity: 0.9;
}

.approach-buttons {
    display: flex;
    gap: 2rem;
    justify-content: center;
    margin-bottom: 3rem;
}

.approach-btn {
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.3);
    color: #fff;
    padding: 0.8rem 2rem;
    border-radius: 25px;
    cursor: pointer;
    font-size: 0.9rem;
    transition: all 0.3s;
    backdrop-filter: blur(10px);
    text-decoration: none;
    display: inline-block;
}

.approach-btn:hover {
    background: rgba(255, 107, 157, 0.3);
    border-color: #ff6b9d;
    transform: translateY(-2px);
}

.scroll-indicator {
    font-size: 2rem;
    animation: bounce 2s infinite;
}

@keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(10px); }
}

/* ELIAC Section */
.eliac-section {
    min-height: 100vh;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    padding: 4rem;
    gap: 2rem;
}

.eliac-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 30% 50%, rgba(255, 255, 255, 0.1) 0%, transparent 50%);
    pointer-events: none;
}

.left-content {
    padding: 3rem;
    z-index: 1;
}

.left-content h2 {
    font-size: 5rem;
    font-weight: bold;
    margin-bottom: 2rem;
    letter-spacing: 0.1em;
}

.left-content p {
    font-size: 1.2rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 400px;
}

.learn-more-btn {
    background: rgba(255, 255, 255, 0.2);
    border: 2px solid #fff;
    color: #fff;
    padding: 0.8rem 2rem;
    border-radius: 25px;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.3s;
    backdrop-filter: blur(10px);
}

.learn-more-btn:hover {
    background: #fff;
    color: #667eea;
    transform: translateX(5px);
}

.right-content {
    padding: 3rem;
    z-index: 1;
}

.info-card {
    background: rgba(255, 255, 255, 0.15);
    padding: 2.5rem;
    border-radius: 20px;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
}

.info-card h3 {
    font-size: 1.8rem;
    margin-bottom: 1rem;
    color: #fff;
}

.info-card p {
    font-size: 1rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.9);
}

/* LINAC Section */
.linac-section {
    min-height: 100vh;
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    padding: 4rem;
    gap: 2rem;
}

.linac-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 70% 50%, rgba(255, 255, 255, 0.1) 0%, transparent 50%);
    pointer-events: none;
}

/* Timeline Section */
.timeline-section {
    min-height: 100vh;
    background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
    padding: 6rem 2rem;
    position: relative;
}

.timeline-header {
    text-align: center;
    margin-bottom: 5rem;
}

.timeline-header h2 {
    font-size: 3.5rem;
    font-weight: bold;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, #ff6b9d, #f5576c);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.timeline-header p {
    font-size: 1.2rem;
    opacity: 0.8;
}

.timeline-container {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    padding: 2rem 0;
}

/* Timeline vertical line */
.timeline-line {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 100%;
    background: linear-gradient(180deg,
        rgba(255, 107, 157, 0) 0%,
        rgba(255, 107, 157, 1) 10%,
        rgba(245, 87, 108, 1) 90%,
        rgba(245, 87, 108, 0) 100%
    );
}

.timeline-item {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 2rem;
    margin-bottom: 4rem;
    align-items: center;
}

.timeline-item.left .timeline-content {
    grid-column: 1;
    text-align: right;
}

.timeline-item.left .timeline-marker {
    grid-column: 2;
}

.timeline-item.right .timeline-content {
    grid-column: 3;
    text-align: left;
}

.timeline-item.right .timeline-marker {
    grid-column: 2;
}

.timeline-marker {
    width: 20px;
    height: 20px;
    background: linear-gradient(135deg, #ff6b9d, #f5576c);
    border-radius: 50%;
    border: 4px solid #0f0c29;
    box-shadow: 0 0 20px rgba(255, 107, 157, 0.5);
    position: relative;
    z-index: 2;
}

.timeline-content {
    background: rgba(255, 255, 255, 0.05);
    padding: 2rem;
    border-radius: 15px;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s;
}

.timeline-content:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(255, 107, 157, 0.3);
}

.timeline-date {
    font-size: 0.9rem;
    color: #ff6b9d;
    font-weight: bold;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.timeline-content h3 {
    font-size: 1.6rem;
    margin-bottom: 1rem;
    color: #fff;
}

.timeline-content p {
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 1rem;
    opacity: 0.9;
}

.milestone-list {
    list-style: none;
    padding-left: 0;
}

.milestone-list li {
    font-size: 0.9rem;
    padding: 0.5rem 0;
    opacity: 0.8;
    position: relative;
    padding-left: 1.5rem;
}

.milestone-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: #ff6b9d;
}

/* Footer */
.main-footer {
    background: #1a1a2e;
    padding: 3rem 2rem;
    color: #fff;
}

.footer-content {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
}

.footer-logo h3 {
    font-size: 1.5rem;
    color: #ff6b9d;
}

.footer-links ul {
    list-style: none;
}

.footer-links a {
    color: #fff;
    text-decoration: none;
    display: block;
    margin-bottom: 0.5rem;
    transition: color 0.3s;
}

.footer-links a:hover {
    color: #ff6b9d;
}

.footer-contact p {
    margin-bottom: 0.8rem;
    font-size: 0.9rem;
}

.footer-partners p {
    font-weight: bold;
    color: #ff6b9d;
}

/* Responsive Design */
@media (max-width: 768px) {
    .hero-content h1 {
        font-size: 2.5rem;
    }

    .approach-buttons {
        flex-direction: column;
        gap: 1rem;
    }

    .eliac-section,
    .linac-section {
        grid-template-columns: 1fr;
        padding: 2rem;
    }

    .left-content h2 {
        font-size: 3rem;
    }

    .footer-content {
        grid-template-columns: 1fr;
    }

    .main-nav {
        grid-template-columns: 1fr;
        text-align: center;
    }

    .nav-links {
        justify-content: center;
        flex-wrap: wrap;
    }

    /* Timeline mobile */
    .timeline-line {
        left: 20px;
    }

    .timeline-item {
        grid-template-columns: auto 1fr;
        gap: 1rem;
    }

    .timeline-item.left .timeline-content,
    .timeline-item.right .timeline-content {
        grid-column: 2;
        text-align: left;
    }

    .timeline-item.left .timeline-marker,
    .timeline-item.right .timeline-marker {
        grid-column: 1;
    }

    .timeline-header h2 {
        font-size: 2.5rem;
    }
}

/* Smooth Scroll */
html {
    scroll-behavior: smooth;
}

/* Adjust for fixed navbar */
section {
    scroll-margin-top: 80px;
}
</style>
