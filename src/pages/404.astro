---
// The page GitHub Pages serves for any address that does not exist, in every
// language: GitHub serves this one file, so the cover is in English and the
// way back is offered in Spanish and Valencian too. Placeholder copy until
// the team's content document. The sitemap leaves it out.
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import Button from '../components/Button.astro';
---

<Base title="Page not found" description="This page does not exist, or it moved when the site was rebuilt.">
  <Cover
    id="not-found"
    kicker="404 · PAGE NOT FOUND"
    shout={['BEAM LOST']}
    lead="This page does not exist, or it moved when the site was rebuilt. The beam starts again from the home page."
  >
    <Fragment slot="actions">
      <Button href="/">Back to the home page</Button>
      <Button href="/research/" variant="secondary">Research</Button>
    </Fragment>
    <div class="elsewhere">
      <Button href="/es/" variant="text" lang="es" hreflang="es">VOLVER AL INICIO</Button>
      <Button href="/va/" variant="text" lang="ca-ES-valencia" hreflang="ca-ES-valencia">TORNAR A L’INICI</Button>
    </div>
  </Cover>
</Base>

<style>
  .elsewhere {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
  }
</style>
