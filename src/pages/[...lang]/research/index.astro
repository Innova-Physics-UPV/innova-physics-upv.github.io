---
// /research/ (and /es/, /va/): every paper, poster and write-up as a block. A block opens the
// item's page; its venue links out to the publication itself. Published
// items newest first, then the ones still to come. To add one, add a folder
// to src/content/research/.
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Cover from '../../../components/Cover.astro';
import Section from '../../../components/Section.astro';
import Sheet from '../../../components/Sheet.astro';
import Button from '../../../components/Button.astro';
import ResearchCard from '../../../components/ResearchCard.astro';
import { researchPage } from '../../../data/research';
import { alternates, everyLang, inLang, type Lang } from '../../../i18n';

export const getStaticPaths = everyLang;

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = inLang(researchPage, lang);
const all = await getCollection('research');
const byDate = (a: (typeof all)[number], b: (typeof all)[number]) => b.data.date.valueOf() - a.data.date.valueOf();
const items = [
  ...all.filter((i) => i.data.status !== 'coming').sort(byDate),
  ...all.filter((i) => i.data.status === 'coming').sort(byDate).reverse(),
];
const { closing } = t;
---

<Base title={t.title} active="research" description={t.lead} languages={alternates('/research/')}>
  <Cover id="research" kicker={t.kicker} shout={[t.shout]} lead={t.lead} />

  <main data-theme="gesso">
    <Section id="published" kicker={`${items.length} ${t.items}`} title={t.listTitle}>
      <ul class="grid">
        {
          items.map((item) => (
            <li>
              <ResearchCard item={item} />
            </li>
          ))
        }
      </ul>
    </Section>

    <Sheet id="open" labelledby="open-title">
      <div class="closing__text">
        <p class="label muted">{closing.kicker}</p>
        <h2 id="open-title" class="headline closing__title">{closing.title}</h2>
        <p class="closing__body measure">{closing.text}</p>
      </div>
      <div class="closing__actions">
        <Button href={closing.action.href}>{closing.action.label}</Button>
      </div>
    </Sheet>
  </main>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 24px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
  }

  .grid > li {
    display: flex;
  }

  .grid > li > :global(*) {
    flex: 1;
  }

  .closing__text {
    flex: 1 1 360px;
    max-width: 560px;
  }

  .closing__title,
  .closing__body {
    margin-top: 24px;
  }

  .closing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
</style>
