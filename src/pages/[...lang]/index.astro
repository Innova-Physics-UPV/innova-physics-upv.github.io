---
// /, /es/ and /va/, the home: an ultramarine cover, then the team's story
// told on gesso as a beamline, the target, the Join call as a sheet, the
// partners and the footer. Geometry from the canvas's "Home · desktop"; the
// copy is in src/data/home.ts.
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import Button from '../../components/Button.astro';
import Caption from '../../components/Caption.astro';
import Sheet from '../../components/Sheet.astro';
import MarkerKey from '../../components/MarkerKey.astro';
import Rail from '../../components/Rail.astro';
import CoverSource from '../../components/home/CoverSource.astro';
import PartnerRow from '../../components/home/PartnerRow.astro';
import TwoReadings from '../../components/islands/TwoReadings.svelte';
import team from '../../assets/photos/team.webp';
import { FORM_URL, PAST_SEASONS_LIVE } from '../../consts';
import { home } from '../../data/home';
import { closesOn, round, roundIsOpen } from '../../data/recruitment';
import { alternates, everyLang, inLang, localise, type Lang } from '../../i18n';
import { joinCopy } from '../../i18n/join';
import { ui } from '../../i18n/ui';

export const getStaticPaths = everyLang;

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = inLang(home, lang);
const j = joinCopy[lang];
const link = (href: string) => localise(href, lang);

const stations = (await getCollection('seasons'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({ id: entry.id, ...inLang(entry.data, lang) }))
  .map((station) => (station.link ? { ...station, link: { ...station.link, href: link(station.link.href) } } : station));

const open = roundIsOpen();
const closes = closesOn(lang);

// S4 lights the team statement word by word: each word is its own span, its
// space inside it (compressHTML drops whitespace between elements).
const words = t.team.statement.split(' ');
---

<Base active="home" languages={alternates('/')}>
  <Cover kicker={t.cover.kicker} shout={t.cover.shout} home scene="s1" cueScene={t.cover.cueScene} lead={inLang(ui.site.description, lang)}>
    <Fragment slot="actions">
      <Button href={link('/join/')}>{t.cover.join}</Button>
      <Button href="#team" variant="secondary" data-follow>{t.cover.follow}</Button>
    </Fragment>
    <CoverSource slot="figure" />
  </Cover>

  <main data-theme="gesso">
    <!-- The team: from here on, paper. -->
    <section id="team" class="team" aria-labelledby="team-title" data-scene="s2">
      <div class="team__track" data-track>
      <div class="team__stage" data-stage>
      <div class="team__wrap">
        <div class="team__text">
          <p class="label muted">{t.team.kicker}</p>
          <h2 id="team-title" class="headline team__title">{t.team.title}</h2>
          <p class="team__statement measure" data-statement>
            {words.map((word, i) => <span class="w">{i < words.length - 1 ? `${word} ` : word}</span>)}
          </p>
          <p class="label muted team__facts">{t.team.facts}</p>
        </div>
        <figure class="team__figure">
          <div class="team__photo" data-team-photo>
            {/* Where S2 runs, the photo grows to cover the window: load the size it ends at. */}
            <Picture
              src={team}
              alt={t.team.photoAlt}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[480, 720, 960, 1280, 1600, 1920, 2560]}
              sizes="(min-width: 1040px) and (min-height: 700px) max(100vw, calc((100vh - 70px) * 1.78)), (min-width: 1024px) 60vw, calc(100vw - 40px)"
              class="team__img"
            />
            <span class="team__veil" aria-hidden="true" data-team-veil></span>
          </div>
          <Caption lead={t.team.caption.lead} text={t.team.caption.text} />
        </figure>
      </div>
      </div>
      </div>
    </section>

    <!-- Our story: one beamline, season by season. -->
    <section id="story" class="story" aria-labelledby="story-title">
      <div class="story__wrap">
        <div class="story__head">
          <p class="label muted">{t.story.kicker}</p>
          <h2 id="story-title" class="headline story__title">{t.story.title}</h2>
          <p class="lead story__lead">{t.story.lead}</p>
          <MarkerKey />
        </div>
        <Rail stations={stations} projector />
        {
          PAST_SEASONS_LIVE && (
            <p class="story__past">
              <Button href={link('/seasons/')} variant="text">{t.story.past}</Button>
            </p>
          )
        }
      </div>
    </section>

    <!-- The target: two readings, the signature interaction. -->
    <section id="readings" class="readings" aria-labelledby="readings-title">
      <div class="readings__wrap">
        <div class="readings__head">
          <div class="readings__title-block">
            <p class="label muted">{t.readings.kicker}</p>
            <h2 id="readings-title" class="art readings__title">{t.readings.title.before}<em>{t.readings.title.em}</em></h2>
          </div>
          <p class="readings__text measure">{t.readings.text}</p>
        </div>
        <TwoReadings lang={lang} client:visible />
      </div>
    </section>

    <!-- Join: an ultramarine sheet laid on the page. -->
    <Sheet id="join" labelledby="join-title">
      <div class="join__text">
        <p class="label muted">{j.closing.kicker(round.season)}</p>
        <h2 id="join-title" class="headline join__title">{j.closing.title}</h2>
        <p class="join__body measure">
          {t.join.body}{' '}{open ? j.closing.open(closes) : j.closing.closed(closes)}
        </p>
        <p class="caption join__privacy">{j.privacy.before}<a href={j.privacy.href}>{j.privacy.link}</a>{j.privacy.after}</p>
      </div>
      <div class="join__actions">
        {open ? <Button href={FORM_URL}>{j.cover.apply}</Button> : <Button href={link('/join/')}>{j.cover.waitlist}</Button>}
        <Button href={link('/join/#team')} variant="secondary">{t.join.meet}</Button>
      </div>
    </Sheet>

    <PartnerRow title={t.partners.title} become={t.partners.become} href={link('/partners/')} />
  </main>
</Base>

<style>
  .team__wrap,
  .story__wrap,
  .readings__wrap {
    max-width: var(--content);
    margin-inline: auto;
    padding: var(--section) var(--pad) 0;
  }

  /* The team */
  .team__wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 48px 80px;
    align-items: flex-start;
  }

  .team__text {
    flex: 1 1 340px;
    max-width: 560px;
  }

  .team__title {
    margin-top: 24px;
  }

  .team__statement,
  .team__facts {
    margin-top: 32px;
  }

  .team__figure {
    flex: 999 1 480px;
    min-width: 0;
  }

  .team__photo {
    position: relative;
    overflow: clip;
  }

  .team__photo :global(.team__img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* The veil of page-coloured hatching (6px of every 8px). Withdrawn in the
     finished state; motion.ts sets it before the photo is restored. */
  .team__veil {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(90deg, var(--page) 0 6px, transparent 6px 8px);
    clip-path: inset(0 0 0 100%);
  }

  /* Our story */
  .story__head {
    max-width: 760px;
  }

  .story__title {
    margin-top: 24px;
  }

  .story__lead {
    margin-top: 24px;
    max-width: 560px;
  }

  .story__past {
    margin-top: var(--station);
    padding-left: var(--rail);
  }

  /* The target */
  .readings__head {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 80px;
    align-items: flex-end;
    justify-content: space-between;
  }

  .readings__title-block {
    flex: 1 1 480px;
  }

  .readings__title {
    margin-top: 24px;
  }

  .readings__text {
    flex: 1 1 320px;
  }

  /* Join */
  .join__text {
    flex: 1 1 360px;
    max-width: 560px;
  }

  .join__title,
  .join__body {
    margin-top: 24px;
  }

  .join__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .join__privacy {
    margin-top: 16px;
    color: var(--figure-muted);
  }

  .join__privacy a {
    color: var(--figure);
    text-decoration-thickness: var(--hair);
    text-underline-offset: 3px;
  }
</style>
