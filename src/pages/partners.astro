---
import Layout from '../Layout/layout.astro';
import PartnerWall from '../Components/Partners/PartnerWall.astro';
import DossierAside from '../Components/Partners/DossierAside.astro';
---

<Layout title="Partners" lang="en">
  <main class="contenedor partners-page">
    <h1 class="title-hero">Partners</h1>

    <div class="partners-layout">
      <PartnerWall />
      <DossierAside />
    </div>
  </main>
</Layout>

<style>
  .partners-page h1 {
    margin-bottom: 3rem;
    font-size: clamp(3.5rem, 8vw, 6rem);
  }

  /* Partners take the wide column, the dossier sits beside them. Below
     1200px the partner cards would shrink too much, so the dossier moves
     underneath instead. */
  .partners-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
    align-items: start;
    gap: 3rem;
  }

  @media (max-width: 1200px) {
    .partners-layout { grid-template-columns: 1fr; }
  }
</style>
