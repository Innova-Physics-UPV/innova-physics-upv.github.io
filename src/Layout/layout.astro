---
import '../styles/globals.css';
import Header from '../Components/Header.astro';
import Footer from '../Components/Footer.astro';

const { title = 'Innova Physics UPV', lang = 'es', curves = true } = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>

  <body>
    <div class="bg-wrapper">

      {curves && (
        <>
          <img src="/curves1.webp" class="bg-image-percent" style="--top: 0%; --bottom: 60%; --left: 0%; --right: 0%;" alt="">
          <img src="/curves2.webp" class="bg-image-percent" style="--top: 0%; --bottom: 60%; --left: 0%; --right: 0%;" alt="">
          <img src="/curves4.webp" class="bg-image-percent" style="--top: 30%; --bottom: 30%; --left: 0%; --right: 0%;" alt="">
          <img src="/curves3.webp" class="bg-image-percent" style="--top: 60%; --bottom: 0%; --left: 0%; --right: 0%;" alt="">
        </>
      )}

      <div class="content-overlay">
        <Header />
        <slot />
        <Footer />
      </div>

    </div>
  </body>
</html>
