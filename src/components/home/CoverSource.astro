---
// The cover figure: the recoloured COMSOL render of the ALOHA-0 electron
// source, in two layers on the same 1600 × 960 crop. The wireframe (the
// electrodes on ultramarine) and the beam (the trajectories alone, with
// transparency). The HTML shows both: the finished frame. S1 (motion.ts)
// switches the beam on with the reader's scroll.
import { Picture } from 'astro:assets';
import wire from '../../assets/figures/aloha-0-source-wire.webp';
import beam from '../../assets/figures/aloha-0-source-beam.webp';
import { home } from '../../data/home';
import { inLang, langOf } from '../../i18n';

const t = inLang(home.source, langOf(Astro.currentLocale));

const widths = [800, 1200, 1600];
const sizes = '(min-width: 1024px) 64vw, 100vw';
---

<figure class="source" data-source>
  <div class="source__frame" data-source-frame>
    <Picture
      src={wire}
      alt={t.alt}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={widths}
      sizes={sizes}
      priority
      class="source__layer"
    />
    <span class="source__path" aria-hidden="true">
      <Picture src={beam} alt="" formats={['avif', 'webp']} fallbackFormat="webp" widths={widths} sizes={sizes} priority class="source__layer" />
    </span>
    <span class="source__beam" aria-hidden="true" data-source-beam>
      <Picture src={beam} alt="" formats={['avif', 'webp']} fallbackFormat="webp" widths={widths} sizes={sizes} priority class="source__layer" />
    </span>
    <!-- S1 names each electrode as the beam passes it (positions from the
         canvas's "Scroll scenes" board, as fractions of the frame). -->
    <ol class="source__labels" aria-hidden="true">
      <li class="source__label source__label--1">
        <span class="source__dot" style="left: 21.5%; top: 37.5%"></span>
        <span class="source__tag" style="left: 4%; top: 20%">{t.cathode}</span>
      </li>
      <li class="source__label source__label--2">
        <span class="source__dot" style="left: 45%; top: 26%"></span>
        <span class="source__tag" style="left: 47%; top: 15%">{t.anode}</span>
      </li>
      <li class="source__label source__label--3">
        <span class="source__tag" style="left: 50%; top: 86%">{t.telefocus}</span>
      </li>
    </ol>
  </div>
  <figcaption class="source__caption caption">
    <span><strong>{t.caption.lead}</strong> {t.caption.text}</span>
    <span class="label source__scale">
      {t.energy} · 0 <span class="source__ramp" aria-hidden="true"></span> 30 keV
    </span>
  </figcaption>
</figure>

<style>
  .source__frame {
    position: relative;
    aspect-ratio: 5 / 3;
  }

  .source__frame :global(.source__layer) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .source__path,
  .source__beam {
    position: absolute;
    inset: 0;
  }

  /* Before S1 the beam is off: its planned path shows at 16%. In the
     finished frame the beam layer covers it. */
  .source__path {
    opacity: 0.16;
  }

  /* The electrode labels belong to S1: shown only while it runs
     (motion.css). Positions are fractions of the frame. */
  .source__labels {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    position: absolute;
    inset: 0;
    color: var(--lead-white);
  }

  .source__label {
    position: absolute;
    inset: 0;
  }

  .source__dot,
  .source__tag {
    position: absolute;
    transform-origin: 0 0;
  }

  .source__dot {
    width: var(--beam);
    height: var(--beam);
    margin: -4px 0 0 -4px;
    background: var(--lead-white);
  }

  /* A lead-white label box with ultramarine type (8.5:1), so a label stays
     legible where it crosses the wireframe. */
  .source__tag {
    padding: 2px 6px;
    background: var(--lead-white);
    color: var(--ultramarine);
    font-family: var(--mono);
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .source__caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 32px;
    padding: 16px var(--pad) 0 0;
    color: var(--figure-muted);
  }

  .source__caption strong {
    font-weight: 700;
    color: var(--figure);
  }

  .source__scale {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  /* The legend of the render's colour scale, from lapis light (low energy)
     to vermilion (30 keV). A key to data, not a decorative gradient. */
  .source__ramp {
    display: inline-block;
    width: 96px;
    height: var(--beam);
    background: linear-gradient(90deg, #c9cfee 0%, #d3afbd 25%, #d78d8d 50%, #d7685c 75%, #d4391f 100%);
  }
</style>
