---
// The key to the story's markers.
import { inLang, langOf } from '../i18n';
import { ui } from '../i18n/ui';

const t = inLang(ui.markers, langOf(Astro.currentLocale));
---

<ul class="marker-key" aria-label={t.label}>
  <li class="label muted"><span class="marker-key__swatch marker-key__swatch--solid" aria-hidden="true"></span>{t.built}</li>
  <li class="label muted"><span class="marker-key__swatch marker-key__swatch--hatched" aria-hidden="true"></span>{t.simulated}</li>
  <li class="label muted"><span class="marker-key__swatch marker-key__swatch--outlined" aria-hidden="true"></span>{t.notYet}</li>
  <li class="label muted"><span class="marker-key__swatch marker-key__swatch--beam" aria-hidden="true"></span>{t.beam}</li>
</ul>

<style>
  .marker-key {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .marker-key li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .marker-key__swatch {
    display: inline-block;
    width: 14px;
    height: 14px;
  }

  .marker-key__swatch--solid {
    background: var(--figure);
  }

  .marker-key__swatch--hatched {
    background: repeating-linear-gradient(90deg, var(--figure) 0 2px, transparent 2px 4px);
  }

  .marker-key__swatch--outlined {
    border: var(--hair) solid var(--figure);
  }

  .marker-key__swatch--beam {
    width: 24px;
    height: var(--beam);
    background: var(--accent);
  }
</style>
