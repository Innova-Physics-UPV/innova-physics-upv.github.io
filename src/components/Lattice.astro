---
// A machine on its axis, drawn by status: built or measured is solid,
// simulated is hatched (tratteggio: 4px strokes on an 8px pitch), design or
// planned is an outline. No text inside: the caption is HTML. Colours come
// from the theme (--figure on --ground), so the same drawing works on gesso,
// at night and on an ultramarine cover.
import type { LatticeFigure } from '../data/figures';

interface Props {
  figure: LatticeFigure;
  /** Unique on the page: names the hatch pattern. */
  id: string;
}

const { figure, id } = Astro.props;
const hatch = `tratteggio-${id}`;
const box = (r: { x: number; y: number; w: number; h: number }) => ({ x: r.x, y: r.y, width: r.w, height: r.h });
---

<svg class="lattice" viewBox={figure.viewBox} role="img" aria-label={figure.label}>
  <defs>
    <pattern id={hatch} width="8" height="8" patternUnits="userSpaceOnUse">
      <rect x="2" y="0" width="4" height="8" style="fill: var(--figure, var(--ink))"></rect>
    </pattern>
  </defs>
  {figure.construction && <rect {...box(figure.construction)} style="fill: var(--construction, var(--line))" />}
  {figure.axis && <rect {...box(figure.axis)} style="fill: var(--figure, var(--ink))" />}
  {
    figure.elements.map((el) => {
      const stroke = el.stroke ?? (el.status === 'simulated' ? 1.5 : el.status === 'design' ? 3 : 0);
      if (el.shape === 'ellipse') {
        return (
          <ellipse
            cx={el.cx}
            cy={el.cy}
            rx={el.rx}
            ry={el.ry}
            fill={el.status === 'simulated' ? `url(#${hatch})` : undefined}
            stroke-width={stroke}
            style={
              el.status === 'built'
                ? 'fill: var(--figure, var(--ink))'
                : el.status === 'design'
                  ? 'fill: none; stroke: var(--figure, var(--ink))'
                  : 'stroke: var(--figure, var(--ink))'
            }
          />
        );
      }
      return (
        <rect
          {...box(el)}
          fill={el.status === 'simulated' ? `url(#${hatch})` : undefined}
          stroke-width={stroke || undefined}
          style={
            el.status === 'built'
              ? 'fill: var(--figure, var(--ink))'
              : el.status === 'design'
                ? 'fill: var(--ground, var(--page)); stroke: var(--figure, var(--ink))'
                : 'stroke: var(--figure, var(--ink))'
          }
        />
      );
    })
  }
</svg>

<style>
  .lattice {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
