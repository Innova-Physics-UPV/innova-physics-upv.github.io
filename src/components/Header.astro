---
// The masthead: a sticky ultramarine band, like the CERN Courier's. It
// tightens once the cover has gone by (M2, in motion.ts). On a Pentimento
// Logbook entry it is drawn on gesso instead.
import InnovaCompact from '../assets/logos/innova-compact.svg';

type Section = 'home' | 'machine' | 'logbook' | 'team' | 'join' | 'partners' | 'seasons';
type Locale = 'en' | 'es' | 'ca-ES-valencia';

interface Props {
  theme?: 'ultramarine' | 'gesso';
  active?: Section;
  /** This page in each language it exists in. Missing languages show as plain text. */
  languages?: Partial<Record<Locale, string>>;
}

const { theme = 'ultramarine', active, languages = {} } = Astro.props;
const current = (Astro.currentLocale ?? 'en') as Locale;

const nav: { key: Section; label: string; href: string }[] = [
  { key: 'machine', label: 'MACHINE', href: '/machine/' },
  { key: 'logbook', label: 'LOGBOOK', href: '/logbook/' },
  // The team lives on /join until it outgrows it.
  { key: 'team', label: 'TEAM', href: '/join/#team' },
  { key: 'partners', label: 'PARTNERS', href: '/partners/' },
];

const langs: { code: Locale; label: string; name: string }[] = [
  { code: 'en', label: 'EN', name: 'English' },
  { code: 'es', label: 'ES', name: 'Español' },
  { code: 'ca-ES-valencia', label: 'VAL', name: 'Valencià' },
];
---

<header class="masthead" data-theme={theme} data-masthead>
  <div class="masthead__inner">
    <a class="masthead__logo" href="/" aria-label="Innova Physics, home">
      <InnovaCompact aria-hidden="true" focusable="false" />
    </a>
    <nav class="masthead__nav" aria-label="Main">
      {
        nav.map((item) => (
          <a class="label masthead__link" href={item.href} aria-current={item.key === active ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a class="label masthead__join" href="/join/" aria-current={active === 'join' ? 'page' : undefined}>JOIN</a>
      <span class="masthead__sep" aria-hidden="true"></span>
      <span class="masthead__langs" role="group" aria-label="Language">
        {
          langs.map((l) =>
            l.code === current ? (
              <span class="label masthead__lang" lang={l.code} aria-current="true">
                {l.label}
              </span>
            ) : languages[l.code] ? (
              <a class="label masthead__lang muted" href={languages[l.code]} lang={l.code} hreflang={l.code} title={l.name}>
                {l.label}
              </a>
            ) : (
              <span class="label masthead__lang masthead__lang--off" lang={l.code} title={`${l.name}: this page is in English only`}>
                {l.label}
              </span>
            ),
          )
        }
      </span>
      <span class="masthead__sep js-only" aria-hidden="true"></span>
      <button class="label masthead__dark js-only" type="button" aria-pressed="false" data-dark-switch>
        <span class="masthead__swatch" aria-hidden="true"></span>DARK
      </button>
    </nav>
  </div>
</header>

<script>
  import '../scripts/mode';
</script>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: var(--hair) solid var(--construction);
    view-transition-name: masthead;
  }

  .masthead__inner {
    max-width: var(--content);
    margin-inline: auto;
    padding: 24px var(--pad);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 40px;
    transition: padding 200ms linear;
  }

  .masthead__logo {
    display: block;
    line-height: 0;
    color: var(--figure);
  }

  .masthead__logo :global(svg) {
    height: 44px;
    width: auto;
    transition: height 200ms linear;
  }

  /* M2: the masthead tightens while you read. */
  .masthead.is-compact .masthead__inner {
    padding-block: 12px;
  }

  .masthead.is-compact .masthead__logo :global(svg) {
    height: 32px;
  }

  :global(html:not([data-motion])) .masthead__inner,
  :global(html:not([data-motion])) .masthead__logo :global(svg) {
    transition: none;
  }

  .masthead__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 28px;
  }

  .masthead__link,
  .masthead__lang {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--figure);
    text-decoration: none;
    border-bottom: var(--hair) solid transparent;
  }

  .masthead__link[aria-current='page'],
  .masthead__lang[aria-current='true'] {
    border-bottom-color: var(--figure);
  }

  a.masthead__lang {
    color: var(--figure-muted);
  }

  /* A language this page does not exist in: plain text, never a dead link. */
  .masthead__lang--off {
    color: var(--figure-muted);
    cursor: default;
  }

  .masthead__langs {
    display: inline-flex;
    gap: 14px;
  }

  /* JOIN, the one call to action: boxed, filled on its own page. */
  .masthead__join {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    color: var(--figure);
    text-decoration: none;
    border: var(--hair) solid var(--figure);
    transition:
      background-color 120ms linear,
      color 120ms linear;
  }

  .masthead__join[aria-current='page'],
  .masthead__join:hover {
    background: var(--figure);
    color: var(--ground);
  }

  .masthead__sep {
    width: var(--hair);
    height: 20px;
    background: var(--construction);
  }

  .masthead__dark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--figure);
    cursor: pointer;
  }

  /* A 12px square: outlined by day, filled by night. */
  .masthead__swatch {
    display: inline-block;
    width: 12px;
    height: 12px;
    border: var(--hair) solid var(--figure);
  }

  .masthead__dark[aria-pressed='true'] .masthead__swatch {
    background: var(--figure);
  }

  :global(html:not([data-motion])) .masthead__join {
    transition: none;
  }
</style>
