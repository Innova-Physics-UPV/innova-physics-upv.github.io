---
// The masthead: a sticky ultramarine band, like the CERN Courier's. It
// tightens once the cover has gone by (M2, in motion.ts). On a research
// item about art or conservation it is drawn on gesso instead.
import InnovaCompact from '../assets/logos/innova-compact.svg';
import { htmlLang, inLang, langNames, langOf, langs, localise, type Lang } from '../i18n';
import { ui } from '../i18n/ui';

type Section = 'home' | 'machine' | 'research' | 'team' | 'join' | 'partners' | 'seasons';

interface Props {
  theme?: 'ultramarine' | 'gesso';
  active?: Section;
  /** This page in each language it exists in. Missing languages show as plain text. */
  languages?: Partial<Record<Lang, string>>;
  /** M10: a vermilion line over the hairline grows with the reading (research items). */
  progress?: boolean;
}

const { theme = 'ultramarine', active, languages = {}, progress = false } = Astro.props;
const current = langOf(Astro.currentLocale);
const t = inLang(ui.masthead, current);

const nav: { key: Section; label: string; href: string }[] = [
  { key: 'machine', label: t.machine, href: '/machine/' },
  { key: 'research', label: t.research, href: '/research/' },
  // The team lives on /join until it outgrows it.
  { key: 'team', label: t.team, href: '/join/#team' },
  { key: 'partners', label: t.partners, href: '/partners/' },
];
---

<header class="masthead" data-theme={theme} data-masthead>
  <div class="masthead__inner">
    <a class="masthead__logo" href={localise('/', current)} aria-label={t.home}>
      <InnovaCompact aria-hidden="true" focusable="false" />
    </a>
    <nav class="masthead__nav" aria-label={t.nav}>
      {
        nav.map((item) => (
          <a class="label masthead__link" href={localise(item.href, current)} aria-current={item.key === active ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a class="label masthead__join" href={localise('/join/', current)} aria-current={active === 'join' ? 'page' : undefined}>{t.join}</a>
      <span class="masthead__sep" aria-hidden="true"></span>
      <span class="masthead__langs" role="group" aria-label={t.language}>
        {
          langs.map((l) =>
            l === current ? (
              <span class="label masthead__lang" lang={htmlLang[l]} aria-current="true">
                {langNames[l].label}
              </span>
            ) : languages[l] ? (
              <a class="label masthead__lang muted" href={languages[l]} lang={htmlLang[l]} hreflang={htmlLang[l]} title={langNames[l].name}>
                {langNames[l].label}
              </a>
            ) : (
              <span class="label masthead__lang masthead__lang--off" title={`${langNames[l].name}: ${t.onlyIn}`}>
                {langNames[l].label}
              </span>
            ),
          )
        }
      </span>
      <span class="masthead__sep js-only" aria-hidden="true"></span>
      <button class="label masthead__dark js-only" type="button" aria-pressed="false" data-dark-switch>
        <span class="masthead__swatch" aria-hidden="true"></span>{t.dark}
      </button>
    </nav>
  </div>
  {progress && <span class="masthead__progress" aria-hidden="true"></span>}
</header>

<script>
  import '../scripts/mode';
</script>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: var(--hair) solid var(--construction);
    view-transition-name: masthead;
    /* M2: the margin gives back what the band loses, in step with it, so
       the page's height never changes while the band tightens. */
    transition: margin-bottom 200ms linear;
  }

  .masthead__inner {
    max-width: var(--content);
    margin-inline: auto;
    padding: 24px var(--pad);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 40px;
    transition: padding 200ms linear;
  }

  .masthead__logo {
    display: block;
    line-height: 0;
    color: var(--figure);
  }

  .masthead__logo :global(svg) {
    height: 44px;
    width: auto;
    transition: height 200ms linear;
  }

  /* M2: the masthead tightens while you read. */
  .masthead.is-compact .masthead__inner {
    padding-block: 12px;
  }

  .masthead.is-compact .masthead__logo :global(svg) {
    height: 32px;
  }


  .masthead__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 28px;
  }

  .masthead__link,
  .masthead__lang {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--figure);
    text-decoration: none;
    border-bottom: var(--hair) solid transparent;
  }

  .masthead__link[aria-current='page'],
  .masthead__lang[aria-current='true'] {
    border-bottom-color: var(--figure);
  }

  a.masthead__lang {
    color: var(--figure-muted);
  }

  /* A language this page does not exist in: plain text, never a dead link. */
  .masthead__lang--off {
    color: var(--figure-muted);
    cursor: default;
  }

  .masthead__langs {
    display: inline-flex;
    gap: 14px;
  }

  /* JOIN, the one call to action: boxed, filled on its own page. */
  .masthead__join {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    color: var(--figure);
    text-decoration: none;
    border: var(--hair) solid var(--figure);
    transition:
      background-color 120ms linear,
      color 120ms linear;
  }

  .masthead__join[aria-current='page'],
  .masthead__join:hover {
    background: var(--figure);
    color: var(--ground);
  }

  .masthead__sep {
    width: var(--hair);
    height: 20px;
    background: var(--construction);
  }

  .masthead__dark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--figure);
    cursor: pointer;
  }

  /* A 12px square: outlined by day, filled by night. */
  .masthead__swatch {
    display: inline-block;
    width: 12px;
    height: 12px;
    border: var(--hair) solid var(--figure);
  }

  .masthead__dark[aria-pressed='true'] .masthead__swatch {
    background: var(--figure);
  }


  /* M10: where the browser links animations to the scroll, the line grows
     from 0 to the full width as the page is read. Elsewhere, and without
     motion, the hairline stays. */
  .masthead__progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    :global(html[data-motion]) .masthead__progress {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      bottom: calc(-1 * var(--hair));
      height: var(--hair);
      background: var(--vermilion);
      transform-origin: 0 50%;
      animation: masthead-read linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes masthead-read {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
    }
  }
</style>
