---
// "The word": a term the reader meets in a research item, set in the art
// voice, and what it means. For MDX items.
interface Props {
  word: string;
}

const { word } = Astro.props;
---

<aside class="term" aria-label={`The word: ${word}`}>
  <p class="label muted">THE WORD</p>
  <p class="term__word">{word}</p>
  <div class="term__text"><slot /></div>
</aside>

<style>
  .term {
    margin-top: 40px;
    padding: 28px;
    background: var(--card);
  }

  .term__word {
    margin-top: 12px;
    font-family: var(--art);
    font-style: italic;
    font-size: clamp(32px, 3.1vw, 44px);
    line-height: 1;
  }

  .term__text {
    margin-top: 12px;
  }
</style>
