---
// A team member: photo in colour, name, role and department. Rendered only
// for people who have given their consent (the page filters on it). With a
// LinkedIn handle, the photo and the name link to the profile; the photo
// itself does not react to the pointer, the name does.
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  person: CollectionEntry<'team'>;
  photoMissing: string;
  /** The link's name, e.g. "Marc Sanchis on LinkedIn". */
  linkLabel: string;
}

const { person, photoMissing, linkLabel } = Astro.props;
const p = person.data;
const href = p.linkedin ? `https://www.linkedin.com/in/${p.linkedin}/` : undefined;
const Head = href ? 'a' : 'div';
const link = href ? { href, rel: 'noopener', 'aria-label': linkLabel } : {};
---

<li class="person">
  <Head class:list={['person__head', href && 'person__link']} {...link}>
    {
      p.photo ? (
        <Picture
          src={p.photo}
          alt={p.alt ?? p.name}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[240, 400, 600]}
          sizes="(min-width: 1040px) 240px, (min-width: 640px) 30vw, 45vw"
          class="person__photo"
        />
      ) : (
        <div class="person__photo person__photo--none">
          <span class="label muted">{photoMissing}</span>
        </div>
      )
    }
    <p class="person__name">{p.name}</p>
  </Head>
  <p class="person__role">{p.role}</p>
  <p class="label muted person__dept">{p.department}</p>
</li>

<style>
  .person :global(.person__photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .person__photo--none {
    display: flex;
    align-items: flex-end;
    padding: 12px;
    background: var(--line);
  }

  .person__head {
    display: block;
  }

  .person__link {
    color: inherit;
    text-decoration: none;
  }

  .person__link:hover .person__name {
    text-decoration: underline;
    text-decoration-thickness: var(--hair);
    text-underline-offset: 4px;
  }

  .person__name {
    margin-top: 12px;
    font-weight: 700;
    line-height: 24px;
  }

  .person__role {
    margin-top: 2px;
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
  }

  .person__dept {
    margin-top: 6px;
  }
</style>
