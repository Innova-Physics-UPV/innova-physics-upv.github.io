---
// A team member: photo in colour, name, role and department. Rendered only
// for people who have given their consent (the page filters on it).
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  person: CollectionEntry<'team'>;
  photoMissing: string;
}

const { person, photoMissing } = Astro.props;
const p = person.data;
---

<li class="person">
  {
    p.photo ? (
      <Picture
        src={p.photo}
        alt={p.alt ?? p.name}
        formats={['avif', 'webp']}
        widths={[240, 400, 600]}
        sizes="(min-width: 1040px) 240px, (min-width: 640px) 30vw, 45vw"
        class="person__photo"
      />
    ) : (
      <div class="person__photo person__photo--none">
        <span class="label muted">{photoMissing}</span>
      </div>
    )
  }
  <p class="person__name">{p.name}</p>
  <p class="person__role">{p.role}</p>
  <p class="label muted person__dept">{p.department}</p>
</li>

<style>
  .person :global(.person__photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .person__photo--none {
    display: flex;
    align-items: flex-end;
    padding: 12px;
    background: var(--line);
  }

  .person__name {
    margin-top: 12px;
    font-weight: 700;
    line-height: 24px;
  }

  .person__role {
    margin-top: 2px;
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
  }

  .person__dept {
    margin-top: 6px;
  }
</style>
