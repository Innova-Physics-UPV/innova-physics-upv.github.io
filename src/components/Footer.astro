---
// The footer on the page ground: the closing row of marks, centred as the
// team likes its closing slides, then address, contact, site and the open
// licences. By day the marks keep their own ink; at night they are one ink,
// white, and the logo is its on-ultramarine version (tokens.css).
import InnovaLogo from '../assets/logos/innova-logo.svg';
import Upv from '../assets/logos/upv.svg';
import Ge from '../assets/logos/generacion-espontanea.svg';
import Etsit from '../assets/logos/etsit.svg';
import { CC_BY_URL, CERN_OHL_URL, CONTACT_EMAIL, PAST_SEASONS_LIVE } from '../consts';
import { inLang, langOf, localise } from '../i18n';
import { ui } from '../i18n/ui';

const lang = langOf(Astro.currentLocale);
const t = inLang(ui.footer, lang);

// The closing row: each mark links to its institution (the team's own to
// the home page).
const marks = [
  { key: 'innova', Mark: InnovaLogo, label: t.innova, href: localise('/', lang) },
  { key: 'upv', Mark: Upv, label: 'Universitat Politècnica de València', href: 'https://www.upv.es/' },
  { key: 'ge', Mark: Ge, label: 'Generación Espontánea, UPV Design Factory', href: 'https://generacionespontanea.upv.es/' },
  { key: 'etsit', Mark: Etsit, label: 'Telecom UPV VLC, ETSIT', href: 'https://www.upv.es/entidades/etsit/' },
];

const site = [
  { label: t.links.home, href: '/' },
  { label: t.links.machine, href: '/machine/' },
  { label: t.links.research, href: '/research/' },
  { label: t.links.join, href: '/join/' },
  { label: t.links.partners, href: '/partners/' },
  ...(PAST_SEASONS_LIVE ? [{ label: t.links.seasons, href: '/seasons/' }] : []),
].map((item) => ({ ...item, href: localise(item.href, lang) }));
---

<footer class="footer" data-theme="gesso">
  <div class="footer__inner">
    <ul class="footer__marks" aria-label={t.marks}>
      {
        marks.map(({ key, Mark, label, href }) => (
          <li class={`footer__mark footer__mark--${key}`}>
            <a class="footer__mark-link" href={href} aria-label={label} rel={href.startsWith('http') ? 'noopener' : undefined}>
              <Mark aria-hidden="true" focusable="false" />
            </a>
          </li>
        ))
      }
    </ul>

    <div class="footer__grid">
      <div>
        <p class="label muted footer__head">{t.address}</p>
        <address class="footer__text">
          Universitat Politècnica de València<br />
          {t.street}<br />
          46022 València
        </address>
      </div>
      <div>
        <p class="label muted footer__head">{t.contact}</p>
        <ul class="footer__list footer__text">
          <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
          <li><a href="https://www.instagram.com/innovaphysicsupv/" rel="noopener">Instagram · @innovaphysicsupv</a></li>
          <li><a href="https://www.linkedin.com/company/innovaphysicsupv/" rel="noopener">LinkedIn · Innova Physics UPV</a></li>
        </ul>
      </div>
      <nav aria-label={t.siteNav}>
        <p class="label muted footer__head">{t.site}</p>
        <ul class="footer__list footer__text">
          {site.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
      <div>
        <p class="label muted footer__head">{t.open}</p>
        <ul class="footer__list label">
          <li><a href={CERN_OHL_URL} rel="noopener">HARDWARE · CERN-OHL-S</a></li>
          <li><a href={CC_BY_URL + t.ccDeed} rel="noopener">{t.texts} · CC BY 4.0</a></li>
          <li>{t.docs}</li>
          <li><a href="/licenses/GUST-FONT-LICENSE.txt">{t.type} · TeX Gyre Heros, GUST</a></li>
          <li>
            <a href="/licenses/OFL-EB-Garamond.txt">EB Garamond</a>, <a href="/licenses/OFL-Fragment-Mono.txt">Fragment Mono</a>, OFL
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__foot">
      <p class="label muted">
        © 2026 INNOVA PHYSICS UPV · VALÈNCIA
        <span aria-hidden="true">{' · '}</span>
        <a href={localise('/legal/', lang)}>{t.legal}</a>
        <span aria-hidden="true">{' · '}</span>
        <a href={localise('/privacy/', lang)}>{t.privacy}</a>
      </p>
      <p class="footer__motto">{t.motto}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: var(--hair) solid var(--figure);
  }

  .footer__inner {
    max-width: var(--content);
    margin-inline: auto;
    padding: clamp(56px, 7vw, 104px) var(--pad) 40px;
  }

  .footer__marks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 32px 40px;
  }

  .footer__mark {
    line-height: 0;
    color: var(--mark);
  }

  .footer__mark-link {
    display: block;
    color: inherit;
  }

  .footer__mark :global(svg) {
    width: auto;
  }

  /* Heights from the closing slide; GE's file carries its own margin. */
  .footer__mark--innova {
    color: var(--logo-ink);
  }

  .footer__mark--innova :global(svg),
  .footer__mark--upv :global(svg) {
    height: 64px;
  }

  .footer__mark--ge :global(svg) {
    height: 84px;
  }

  /* The vector has no margin: 56px matches the 62px PNG of the closing slide. */
  .footer__mark--etsit :global(svg) {
    height: 56px;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 40px;
    margin-top: clamp(56px, 7vw, 96px);
    padding-top: 32px;
    border-top: var(--hair) solid var(--construction);
  }

  .footer__head {
    margin-bottom: 12px;
  }

  .footer__text {
    font-style: normal;
    font-size: 16px;
    line-height: 26px;
  }

  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__list.label {
    line-height: 22px;
  }

  .footer a {
    color: var(--figure);
    text-decoration-thickness: var(--hair);
    text-underline-offset: 4px;
  }

  .footer__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 40px;
    margin-top: 56px;
  }

  .footer__motto {
    font-family: var(--art);
    font-style: italic;
    font-size: 22px;
    line-height: 28px;
  }
</style>
